// An unknown name is still an icon on the screen. Drawing nothing would read as a design
// with a hole in it, so it draws a neutral mark that is clearly a placeholder and keeps the
// name in data-symbol, which is the part that matters.
const UNKNOWN = '<rect x="4" y="4" width="16" height="16" rx="4.6"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>';

// Material asks for the same icon by another word.
const ALIASES = {
  chevron_right: 'chevron.right',
  chevron_left: 'chevron.left',
  expand_more: 'chevron.down',
  expand_less: 'chevron.up',
  keyboard_arrow_down: 'chevron.down',
  keyboard_arrow_right: 'chevron.right',
  close: 'xmark',
  add: 'plus',
  search: 'magnifyingglass',
  notifications: 'bell',
  account_circle: 'person.circle',
  home: 'house',
  layers: 'square.stack',
  settings: 'gear',
  delete: 'trash',
  delete_outline: 'trash',
  edit: 'pencil',
  check: 'checkmark',
  done: 'checkmark',
  arrow_back: 'arrow.left',
  arrow_forward: 'arrow.right',
  more_vert: 'ellipsis',
  more_horiz: 'ellipsis',
  favorite: 'heart',
  favorite_border: 'heart',
  star_outline: 'star',
  grade: 'star',
  schedule: 'clock',
  calendar_today: 'calendar',
  event: 'calendar',
  description: 'doc',
  folder_open: 'folder',
  info: 'info.circle',
  warning: 'exclamationmark.triangle',
  share: 'square.and.arrow.up',
  menu: 'line.3.horizontal',
  mail: 'envelope',
  email: 'envelope',
  call: 'phone',
  photo_camera: 'camera',
  image: 'photo',
  play_arrow: 'play.fill',
  pause: 'pause.fill'
};

// What a `.fill` symbol really is.
//
// SF Symbols draws a filled symbol as the container filled solid and the detail inside it
// cut back out, not as the whole drawing turned into a blob. Filling every part of
// `heart.circle.fill` gave a solid disc with the heart lost inside it. So a part that is
// detail rather than container is marked `data-cut` in the table above: filled, it is
// redrawn over the solid container in the cut colour, which is the surface the icon sits
// on; as an outline, the mark is simply dropped and the part draws like any other.
const CUT = 'var(--db-icon-cut, #FFFFFF)';

const asked = String(name);
// iOS names a solid icon with a .fill suffix, so house.fill is the house shape, filled.
const suffixed = asked.endsWith('.fill');
const base = suffixed ? asked.slice(0, -5) : asked;
const key = SHAPES[asked] ? asked : (SHAPES[ALIASES[asked]] ? ALIASES[asked] : (SHAPES[base] ? base : null));
const shape = key ? SHAPES[key] : UNKNOWN;

// Filling only changes a shape drawn as a closed outline, a house or a heart. On a chevron
// or a checkmark there is nothing to fill, and those are never asked for filled.
const solid = filled || suffixed;
const drawn = solid
  ? shape.replace(/\sdata-cut(?:="[^"]*")?/g, ` fill="none" stroke="${CUT}"`)
  : shape.replace(/\sdata-cut(?:="[^"]*")?/g, '');
---

<svg
  data-symbol={asked}
  data-unknown={key ? undefined : 'true'}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={solid ? color : 'none'}
  stroke={color}
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
><Fragment set:html={drawn} /></svg>

<style>
  svg {
    /* An inline svg sits on the text baseline and leaves a few pixels under it, which pulls
       a row of icons out of line with its label. */
    display: block;
    flex: 0 0 auto;
  }
</style>
