---
// A stand-in for a platform icon.
//
// SF Symbols and Material icons do not render in a browser, and shipping either font with
// a board page is not allowed, so each one is drawn here as a small SVG. A drawing is only
// close to the real glyph, never the same, so the name always goes out as `data-symbol` on
// the svg: whoever builds the screen for real reads the name, not the picture.
//
// Material names map onto the same shapes, because the two platforms want the same icon in
// the same place and the kit should not hold the drawing twice.

interface Props {
  name: string;
  size?: number;
  color?: string;
  /** Stroke width, in the 24 unit box below, so it scales with the icon. */
  weight?: number;
  filled?: boolean;
}

const { name, size = 20, color = 'currentColor', weight = 1.8, filled = false } = Astro.props;

