---
// A flex container, column by default.
//
// Every length prop takes a number or a string. A number is pixels and is written out as
// px; a string is passed through untouched, so a caller can hand it `var(--db-space-4)`
// and keep the screen on the project's own spacing scale.

interface Props {
  direction?: 'column' | 'row';
  gap?: number | string;
  padding?: string;
  align?: string;
  justify?: string;
  grow?: boolean;
  width?: number | string;
  height?: number | string;
}

const {
  direction = 'column',
  gap = 0,
  padding,
  align,
  justify,
  grow = false,
  width,
  height
} = Astro.props;

const len = (v) => (typeof v === 'number' ? `${v}px` : v);

const style = [
  `flex-direction:${direction}`,
  `gap:${len(gap)}`,
  padding ? `padding:${padding}` : null,
  align ? `align-items:${align}` : null,
  justify ? `justify-content:${justify}` : null,
  // A stack that grows fills the space its parent has left. min-height:0 goes with it,
  // because a flex child refuses to shrink below its content without it and a long list
  // then pushes the screen past its own frame.
  grow ? 'flex:1 1 auto;min-height:0;min-width:0' : null,
  width ? `width:${len(width)}` : null,
  height ? `height:${len(height)}` : null
].filter(Boolean).join(';');
---

<div class="stack" style={style}><slot /></div>

<style>
  .stack {
    display: flex;
  }
</style>
