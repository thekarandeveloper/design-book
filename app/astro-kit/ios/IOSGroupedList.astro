---
// The grouped list iOS uses in Settings and in most forms: a header, a rounded box of rows,
// a footer, all on the grouped background.
//
// What is easy to get wrong: the rounded box has to clip its rows, otherwise the first row's
// square top corners sit over the box's round ones and the list looks like a web table. So
// the box clips, and the rows do not have to know they are in one.

interface Props {
  /** The small uppercase label above the group. */
  header?: string;
  footer?: string;
  /** Inset, which is how iOS draws a grouped list by default: the box has a side margin. */
  inset?: boolean;
}

const { header, footer, inset = true } = Astro.props;
---

<section class="ios-group" data-inset={String(inset)}>
  {header && <div class="header">{header}</div>}
  <div class="ios-group-rows"><slot /></div>
  {footer && <div class="footer">{footer}</div>}
</section>

<style>
  .ios-group {
    box-sizing: border-box;
    width: 100%;
    font-family: var(--db-font, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    background: var(--db-background, #F2F2F7);
  }

  .ios-group-rows {
    background: var(--db-surface, #FFFFFF);
    /* 10 is the iOS grouped corner, which is smaller than a card's. */
    border-radius: var(--db-ios-group-radius, 10px);
    overflow: hidden;
  }

  /* An edge to edge group has no margin and no round corners, which is the older plain
     grouped style. */
  .ios-group[data-inset='false'] .ios-group-rows { border-radius: 0; }
  .ios-group[data-inset='true'] { padding: 0 var(--db-space-4, 16px); }

  /* Inside an inset group the label is padded again, so it lines up with the row's text
     at 32 from the edge of the screen, which is where iOS puts it. */
  .header,
  .footer {
    color: var(--db-text-secondary, #4E6177);
    padding: 0 var(--db-space-4, 16px);
  }
  .header {
    font-size: var(--db-ios-footnote, 13px);
    text-transform: uppercase;
    letter-spacing: var(--db-ios-group-header-tracking, 0.3px);
    padding-bottom: var(--db-space-2, 8px);
  }

  .footer {
    font-size: var(--db-ios-footnote, 13px);
    padding-top: var(--db-space-2, 8px);
    line-height: 1.3;
  }
</style>

<style is:global>
  /* The last row in the box has no hairline under it, and the first and last rows take the
     box's corners. The rows arrive through a slot, so they are not this component's own
     elements and a scoped rule cannot reach them: these three are global on purpose, and
     written against the two class names this folder owns so they cannot touch anything else.
     A caller who passes `first` and `last` by hand gets the same result. */
  .ios-group-rows > .ios-row:last-child::after { display: none; }
  .ios-group-rows > .ios-row:first-child {
    border-top-left-radius: var(--db-ios-group-radius, 10px);
    border-top-right-radius: var(--db-ios-group-radius, 10px);
  }
  .ios-group-rows > .ios-row:last-child {
    border-bottom-left-radius: var(--db-ios-group-radius, 10px);
    border-bottom-right-radius: var(--db-ios-group-radius, 10px);
  }
</style>
