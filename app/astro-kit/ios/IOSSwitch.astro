---
// The switch iOS draws in a settings row.
//
// Every board page that had a settings screen on it was building this, and each one built a
// slightly different switch: a track between 48 and 52 wide, a knob with no shadow, an off
// state in whatever grey the page had. It is one shape with one set of numbers, so it is
// here instead.
//
// UIKit's own geometry: the track is 51 by 31 with a 15.5 radius, the knob is 27 across
// sitting 2 inside, and it travels 20 from one end to the other. On it the track is the
// tint colour, off it is `systemFill` at the system's own grey. The knob is white in both
// states, with the two-layer shadow UIKit draws under it.

interface Props {
  on?: boolean;
  /** The colour of the track when it is on. An app's own accent, when it sets one. */
  tint?: string;
  /** Drawn as it looks when the row cannot be changed: the whole control at 50 per cent. */
  disabled?: boolean;
  /** For a row that reads out, so a screen reader says what the switch is for. */
  label?: string;
}

const { on = false, tint, disabled = false, label } = Astro.props;
---

<span
  class="switch"
  data-on={on ? 'true' : 'false'}
  data-disabled={disabled ? 'true' : undefined}
  style={tint ? `--db-ios-switch-on: ${tint}` : undefined}
  role="switch"
  aria-checked={on ? 'true' : 'false'}
  aria-label={label}
  aria-disabled={disabled ? 'true' : undefined}
><span class="knob"></span></span>

<style>
  .switch {
    display: inline-block;
    position: relative;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: var(--db-ios-switch-w, 51px);
    height: var(--db-ios-switch-h, 31px);
    border-radius: var(--db-radius-full, 999px);
    /* Off, iOS fills the track with its own grey rather than with anything of the app's. */
    background: var(--db-ios-switch-off, rgba(120, 120, 128, 0.16));
    /* The hairline inside the off track, which is what keeps it from reading as a hole. */
    box-shadow: inset 0 0 0 var(--db-hairline, 0.5px) rgba(60, 60, 67, 0.08);
  }

  .switch[data-on='true'] {
    background: var(--db-ios-switch-on, var(--db-primary, #34C759));
    box-shadow: none;
  }

  .switch[data-disabled='true'] { opacity: 0.5; }

  .knob {
    position: absolute;
    top: var(--db-ios-switch-pad, 2px);
    left: var(--db-ios-switch-pad, 2px);
    width: var(--db-ios-switch-knob, 27px);
    height: var(--db-ios-switch-knob, 27px);
    border-radius: 50%;
    background: var(--db-ios-switch-knob-fill, #FFFFFF);
    /* UIKit draws two shadows under the knob: a wide soft one and a tight dark one. */
    box-shadow:
      0 3px 8px rgba(0, 0, 0, 0.15),
      0 1px 1px rgba(0, 0, 0, 0.16);
    /* The travel is the track less the knob and both pads: 51 - 27 - 4. */
    transform: translateX(0);
    transition: transform var(--db-ios-switch-ms, 240ms) cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .switch[data-on='true'] .knob {
    transform: translateX(var(--db-ios-switch-travel, 20px));
  }

  @media (prefers-reduced-motion: reduce) {
    .knob { transition: none; }
  }
</style>
