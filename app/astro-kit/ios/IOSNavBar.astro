---
// The navigation bar iOS draws above a screen's content.
//
// The one thing that goes wrong without this: the height. An inline bar is 44 tall and a
// large title bar is 96, which is the same 44 row with the big title under it. Guess it and
// every screen's content sits 52 too high or too low.

interface Props {
  /** Draw the status bar inside this bar, so the two share one background. */
  statusBar?: boolean;
  /** The colour of the status bar's glyphs, when it draws one. */
  statusTint?: 'dark' | 'light';
  /** The time the status bar shows, when it draws one. */
  time?: string;
  title?: string;
  /** A large title bar is 96 tall: the 44 row, then the 34pt title under it. */
  large?: boolean;
  /** The label beside the back chevron. An empty string draws the chevron alone. */
  back?: string;
  scheme?: 'light' | 'dark';
  transparent?: boolean;
  background?: string;
  /** The hairline under the bar. */
  border?: boolean;
  /** How far in the row and the large title start, in points. iOS uses 16; an app with its
   *  own screen inset, which is most of them, passes that instead of restyling the bar. */
  inset?: number;
}

const {
  statusBar = true,
  statusTint = 'dark',
  time = '9:41',
  title = '',
  large = false,
  back,
  scheme = 'light',
  transparent = false,
  background,
  border = true,
  inset
} = Astro.props;

import IOSStatusBar from './IOSStatusBar.astro';

// A transparent bar has no hairline either: the line is the edge of the surface, and there
// is no surface.
const hairline = border && !transparent;

// The inset rides on the element as a variable rather than on a class, because the two
// rules that read it are the row and the large title, and both want the same number.
const vars = [
  background ? `--db-ios-nav-bg: ${background}` : '',
  inset != null ? `--db-ios-nav-x: ${inset}px` : ''
].filter(Boolean).join('; ');

// The chevron is drawn here rather than taken from the icon set, because a back button
// exists on nearly every screen and must not depend on which symbols a project happens to
// have.
---

<header
  class="nav"
  data-scheme={scheme}
  data-large={String(large)}
  data-transparent={String(transparent)}
  data-border={String(hairline)}
  style={vars || undefined}
>
  {statusBar && <IOSStatusBar tint={statusTint} time={time} scheme={scheme} />}

  <div class="row">
    <div class="side leading">
      {back !== undefined && (
        <span class="back">
          <svg class="chev" viewBox="0 0 12 21" aria-hidden="true"><path d="M10.2 1.3 1.8 10.5l8.4 9.2" /></svg>
          {back && <span class="back-label">{back}</span>}
        </span>
      )}
      <slot name="leading" />
    </div>
    {!large && title && <h1 class="title inline">{title}</h1>}
    <div class="side trailing"><slot name="trailing" /></div>
  </div>
  {large && title && <h1 class="title large">{title}</h1>}
</header>

<style>
  .nav {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    font-family: var(--db-font, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    background: var(--db-ios-nav-bg, var(--db-surface, #FFFFFF));
    color: var(--db-text, #152233);
  }
  .nav[data-transparent='true'] { background: transparent; }

  /* The hairline is thinner than a pixel on a phone, so it is drawn as its own line rather
     than as a border, which cannot be half a pixel everywhere. */
  .nav[data-border='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--db-hairline, 0.5px);
    background: var(--db-border, #D8E3EF);
  }

  .row {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: var(--db-ios-nav-height, 44px);
    padding: 0 var(--db-ios-nav-x, 16px);
  }

  .side {
    display: flex;
    align-items: center;
    gap: var(--db-space-2, 8px);
    /* Both sides take the same share, so a centred title stays centred when one side is
       empty. */
    flex: 1 1 0;
    min-width: 0;
  }
  .trailing { justify-content: flex-end; }

  .title {
    margin: 0;
    color: inherit;
  }

  /* Centred on the bar, not on the space between the buttons: a long trailing button must
     not push the title off centre, which is what iOS does. */
  .title.inline {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    height: var(--db-ios-nav-height, 44px);
    max-width: var(--db-ios-nav-title-max, 60%);
    font-size: var(--db-ios-body, 17px);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 96 total: the 44 row above, then this. The title sits on the bottom of its space, which
     is where iOS puts it. */
  .title.large {
    display: flex;
    align-items: flex-end;
    box-sizing: border-box;
    height: calc(var(--db-ios-nav-large-height, 96px) - var(--db-ios-nav-height, 44px));
    padding: 0 var(--db-ios-nav-x, 16px) var(--db-ios-nav-large-bottom, 6px);
    font-size: var(--db-ios-large-title, 34px);
    font-weight: 700;
    letter-spacing: var(--db-ios-large-title-tracking, -0.4px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--db-space-1, 4px);
    color: var(--db-primary, #2E7BF6);
    font-size: var(--db-ios-body, 17px);
    /* A back button is a touch target, so it is at least 44 across including its label. */
    min-height: var(--db-touch, 44px);
  }
  .back-label {
    white-space: nowrap;
    max-width: var(--db-ios-back-label-max, 110px);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chev {
    height: var(--db-ios-chevron-back, 18px);
    width: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
